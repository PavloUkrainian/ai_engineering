# Provider API Configuration (OpenAI, OpenRouter, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_MODEL=gpt-4o-mini

# Local / OSS Model Configuration (Ollama or local OpenAI-compatible server)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2
LOCAL_API_KEY=ollama

# Mock execution mode (if True, uses realistic simulated responses for zero-dependency offline runs)
USE_MOCK_FALLBACK=true
