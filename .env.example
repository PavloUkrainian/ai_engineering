# Provider API Configuration (OpenAI, OpenRouter, etc.)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_MODEL=gpt-4o-mini

# Local / OSS Model Configuration (Ollama or local OpenAI-compatible server)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2
LOCAL_API_KEY=ollama

# Mock execution mode (strictly for offline CI/smoke-tests when no keys/Ollama available)
# WARNING: Must be false for real production LLM benchmarks.
USE_MOCK_FALLBACK=false

# Timeouts in seconds (Provider API and Local Ollama)
REQUEST_TIMEOUT_SECONDS=60.0
LOCAL_REQUEST_TIMEOUT_SECONDS=120.0
